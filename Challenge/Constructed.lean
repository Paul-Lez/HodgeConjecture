  map_add' a b := by have _ := d; have _ := X; sorry
  map_smul' c a := by
    have _ := d; have _ := X; sorry

def chartEvaluationKernel [SmoothOfRelativeDimension d X.hom]
    (U : (Opens (TopCat.of (ComplexPoint X)))ᵒᵖ) (p : ℕ) :
    Submodule ℂ (Algebra.DeRham.RawForm ℂ
